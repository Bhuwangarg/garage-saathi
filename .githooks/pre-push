#!/usr/bin/env bash
# Garage Saathi pre-deploy gate. Runs the deterministic g-saathi smoke/regression
# suite before a push that updates main (the GitHub Pages deploy branch). Other
# branches push without the gate. Bypass once with: git push --no-verify.
#
# Enabled via: git config core.hooksPath .githooks  (run once per clone).
set -uo pipefail

# pre-push receives "<localref> <localsha> <remoteref> <remotesha>" lines on stdin.
push_main=0
while read -r _localref _localsha remoteref _remotesha; do
  case "$remoteref" in refs/heads/main) push_main=1 ;; esac
done
[ "$push_main" -eq 1 ] || exit 0

DIR="$(git rev-parse --show-toplevel)"

# These two run first because they are instant, and because a push that ships
# CSS Chrome 109 cannot parse -- or a v2 worker that could seize the live app --
# is not worth spending a browser suite on.
#
# The floor check only inspects v2/, so it is a no-op on a v1-only push. v1's
# own source is excluded on purpose: its comments discuss several banned CSS
# features by name, and a grep cannot tell a property from prose about it.
FLOOR="$DIR/scripts/check-css-floor.sh"
if [ -x "$FLOOR" ] && [ -d "$DIR/v2" ]; then
  "$FLOOR" "$DIR/v2" || { echo "❌ pre-push: blocked by the Chrome 109 floor."; exit 1; }
fi

ISO="$DIR/scripts/check-v2-isolation.sh"
if [ -x "$ISO" ] && [ -d "$DIR/v2" ]; then
  "$ISO" || { echo "❌ pre-push: v1 and v2 are not isolated."; exit 1; }
fi

# The 47 test files, which nothing ran until now. They are quick, they need no
# server, and every Python one points DB_PATH at a tempfile and pops
# DATABASE_URL, so none can reach production. A test nobody runs cannot fail,
# which is how these had quietly become documentation.
TESTS="$DIR/scripts/run-tests.py"
if [ -f "$TESTS" ]; then
  # No --fast any more: the whole set runs here, in about 84s wall. The one suite
  # this hook used to skip was test_ui_overlay.js, which spent 174 of its 181
  # seconds asleep waiting out real animation durations; it now reads the
  # declared durations and waits on state rather than on the clock: measured back
  # to back against the old one, 67s against 190s on a machine at a load average
  # of 7, and 57s against 164s at a load average of 5. Under heavier load it has
  # been seen at 83-111s, so quote both numbers, not the best one.
  #
  # Its handful of wall-clock checks report NOT MEASURED, loudly and without
  # failing, on a machine too busy to run its own timers on time -- a gate that
  # blocks a push for something that is not a defect gets bypassed, and then it
  # checks nothing. If a suite ever earns a full skip again, put it in SLOW in
  # run-tests.py, which prints what it left out: a silent cap reads as
  # "everything passed".
  python3 "$TESTS" -q || { echo "❌ pre-push: blocked by a failing test suite."; exit 1; }
fi

GATE="$DIR/scripts/predeploy-gate.sh"
[ -x "$GATE" ] || { echo "⚠️  pre-push: $GATE missing/not executable — skipping gate."; exit 0; }
exec "$GATE"
