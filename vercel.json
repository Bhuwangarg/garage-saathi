{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{sync_server.py,wa_client.py,its_lookup.py,crew_trace.py,review_ai.py,name_ai.py,gate_ai.py,bill_ai.py,index.html,export.html,app.js,db.js,sync.js,duty.js,gate.js,trace.js,seed-data.js,seed-docs.js,sw.js,styles.css,manifest.webmanifest,icons/**,assets/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__p=/$1"
    }
  ]
}
