{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.py,index.html,export.html,app.js,db.js,i18n-hi.js,pullapply.js,sync.js,duty.js,gate.js,trace.js,seed-data.js,seed-docs.js,sw.js,styles.css,manifest.webmanifest,icons/**,assets/**,ui/**,v2/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__p=/$1"
    }
  ],
  "crons": [
    {
      "path": "/health",
      "schedule": "*/2 * * * *"
    }
  ]
}
