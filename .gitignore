# Secrets & runtime data — never commit these
.gps_ingest_token
.public_url
sync.db
uploads/
__pycache__/
*.pyc
.vapid_private.pem
.gstack/

.octogent

# Local Xcode device-build output (CI builds its own)
mobile/ios/build-device/

# Crew backups: real Aadhaar and licence numbers. Never commit these.
crew-backup-*.json
.vercel
.env*

# redPro collector ingest token
.redpro_ingest_token
.ai_cron_token

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
.boots

# Third-party agent skills installed by `npx skills add`. Vendored tooling for
# building things *about* this app (illustrations, demos), never code that ships
# to a yard, so it has no business in a repo the fleet runs on. `.claude/agents/`
# and `.claude/workflows/` stay tracked — those are ours; only the installer's
# own output is ignored.
.agents/
.claude/skills/
skills-lock.json

# The marketing hero's build output and dependencies. Its source and the
# vendored kit ARE tracked; what npm and vite produce is not.
marketing/v2-hero/node_modules/
marketing/v2-hero/dist/
